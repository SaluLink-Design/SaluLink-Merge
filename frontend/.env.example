# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Python AI backend
PYTHON_BACKEND_URL=http://localhost:8000

# Automated patient claim email (Resend)
# 1. Create account at https://resend.com and copy an API key (starts with re_)
# 2. For local testing: RESEND_FROM_EMAIL=onboarding@resend.dev (only sends to your Resend signup email)
# 3. For production: verify your practice domain in Resend and use e.g. claims@yourpractice.co.za
# 4. Restart npm run dev after changing these values
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
